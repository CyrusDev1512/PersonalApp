# Sao chép thành .env (cạnh docker-compose.yml). Khi chạy backend trực tiếp, đặt file .env trong thư mục backend/.
# KHÔNG commit file .env.

# Token để app Flutter gọi API (bắt buộc, >= 32 ký tự). Tạo bằng: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# ---- Webhook SePay (https://my.sepay.vn → Tích hợp WebHooks) ----
# Kiểu chứng thực "API Key": SePay gửi header "Authorization: Apikey <SEPAY_API_KEY>"
SEPAY_API_KEY=
# (tuỳ chọn) nếu dùng chữ ký HMAC-SHA256 của SePay
SEPAY_HMAC_SECRET=

# ---- Webhook Casso v2 (https://casso.vn → Webhook) ----
# "Khoá bảo mật" (secure key) dùng để kiểm tra chữ ký X-Casso-Signature
CASSO_SECURE_KEY=

# ---- Telegram ----
# Tạo bot với @BotFather để lấy token. Để trống TELEGRAM_CHAT_ID, chạy server, nhắn /start cho bot để biết chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email biến động số dư (IMAP, nguồn phụ) ----
# Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_POLL_SECONDS=120
# Domain người gửi hợp lệ của từng ngân hàng (email phải qua DKIM/DMARC của domain này)
EMAIL_BANK_DOMAINS=VCB:vietcombank.com.vn,MB:mbbank.com.vn
EMAIL_REQUIRE_DKIM=true

# ---- Nhận diện chuyển khoản giữa các tài khoản của chính bạn ----
# Tên chủ tài khoản (không dấu cũng được), vd: NGUYEN VAN AN
OWNER_NAME=
# Các cụm từ khác báo hiệu chuyển nội bộ, phân cách bằng dấu phẩy
INTERNAL_TRANSFER_HINTS=

# ---- Ngưỡng cảnh báo mặc định (đổi được trong app) ----
WARNING_PERCENT=10
WARNING_MIN_AMOUNT=500000

# ---- Khác ----
DEBUG=false
# BIND_ADDR=0.0.0.0
# CLOUDFLARE_TUNNEL_TOKEN=
