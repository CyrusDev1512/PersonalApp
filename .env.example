# Sao chép thành .env (cạnh docker-compose.yml). Khi chạy backend trực tiếp, đặt file .env trong thư mục backend/.
# KHÔNG commit file .env. Trên Windows, scripts\windows\setup.cmd tự tạo và điền file này.
# Sửa tay: lưu dạng UTF-8 (không dùng UTF-16); giá trị có ký tự $ hoặc # thì đặt trong nháy đơn, vd. KEY='ab$cd'.
# Đổi .env xong chạy "docker compose up -d" (không phải "docker compose restart") để server nạp giá trị mới.
# Lệnh đó chỉ gồm ngrok khi COMPOSE_PROFILES có "ngrok" (setup.cmd tự ghi); không thì: docker compose --profile ngrok up -d

# Token để app Flutter gọi API (bắt buộc, >= 32 ký tự). Tạo bằng: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# ---- Webhook SePay (https://my.sepay.vn → Tích hợp WebHooks) ----
# Kiểu chứng thực "API Key": SePay gửi header "Authorization: Apikey <SEPAY_API_KEY>". Kiểu nội dung: application/json.
# URL webhook: https://<NGROK_DOMAIN>/webhooks/sepay
SEPAY_API_KEY=
# (tuỳ chọn) nếu dùng chữ ký HMAC-SHA256 của SePay
SEPAY_HMAC_SECRET=

# ---- Webhook Casso v2 (https://casso.vn → Webhook) ----
# "Khoá bảo mật" (secure key) dùng để kiểm tra chữ ký X-Casso-Signature
CASSO_SECURE_KEY=

# ---- Telegram ----
# Tạo bot với @BotFather để lấy token. Để trống TELEGRAM_CHAT_ID, chạy server, nhắn /start cho bot để biết chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Thông báo đẩy vào app (Firebase Cloud Messaging, tuỳ chọn) ----
# Khoá service account của project Firebase. Với docker compose: đặt file ở ./secrets/fcm.json (được mount
# read-only vào /run/secrets/fcm.json) rồi bỏ dấu # dòng dưới.
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json
# Hoặc dán thẳng nội dung JSON (một dòng):
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_PROJECT_ID=

# ---- Email biến động số dư (IMAP, nguồn phụ) ----
# Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password, 16 chữ cái, viết liền không dấu cách)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_POLL_SECONDS=120
# Domain người gửi hợp lệ của từng ngân hàng (email phải qua DKIM/DMARC của domain này)
EMAIL_BANK_DOMAINS=VCB:vietcombank.com.vn,MB:mbbank.com.vn
EMAIL_REQUIRE_DKIM=true

# ---- Nhận diện chuyển khoản giữa các tài khoản của chính bạn ----
# Tên chủ tài khoản (không dấu cũng được), vd: NGUYEN VAN AN
OWNER_NAME=
# Các cụm từ khác báo hiệu chuyển nội bộ, phân cách bằng dấu phẩy
INTERNAL_TRANSFER_HINTS=

# ---- Ngưỡng cảnh báo mặc định (đổi được trong app) ----
WARNING_PERCENT=10
WARNING_MIN_AMOUNT=500000

# ---- ngrok: mở server ra Internet (gói miễn phí), dùng với: docker compose --profile ngrok up -d ----
# Authtoken của tài khoản ngrok: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Tên miền miễn phí cố định của tài khoản (xem ở https://dashboard.ngrok.com/domains), chỉ ghi tên miền,
# không có https:// — vd. ten-ngau-nhien.ngrok-free.app. Để trống: ngrok tự dùng tên miền miễn phí của tài khoản.
NGROK_DOMAIN=
# Profile docker compose bật sẵn (docker compose tự đọc từ file .env này). setup.cmd tự ghi "ngrok" khi có NGROK_AUTHTOKEN.
COMPOSE_PROFILES=
# (hiếm khi cần) image ngrok khác bản ghim trong docker-compose.yml, vd. khi ngrok báo agent quá cũ:
# NGROK_IMAGE=ngrok/ngrok:alpine

# ---- Khác ----
DEBUG=false
# BIND_ADDR=0.0.0.0
# Cổng của server trên máy này (mặc định 8000). Windows báo "access permissions" ở cổng 8000: đặt HOST_PORT=18000
# HOST_PORT=8000
# CLOUDFLARE_TUNNEL_TOKEN=
