      "numeralSettle": {
        "ms": 150,
        "easing": "standard",
        "delayMs": 550,
        "kind": "crossfade fixed cells -> proportional"
      },
      "statusHeading": {
        "exitMs": 150,
        "exitEasing": "emphasizedAccelerate",
        "enterMs": 250,
        "enterEasing": "emphasizedDecelerate",
        "enterDelayMs": 100,
        "offsetDp": 8
      },
      "floorRuler": {
        "ms": 500,
        "easing": "emphasizedDecelerate"
      },
      "totalMaxMs": 700,
      "reduceMotion": {
        "heroColor": {
          "ms": 150,
          "easing": "standard"
        },
        "numeral": "instant",
        "statusHeading": "instant",
        "floorRuler": "instant"
      }
    }
